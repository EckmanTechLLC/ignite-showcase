# Local development only. Copy to .env.development.local (git-ignored; not read by `vite build`).
# In production the gateway injects window.__IGNITE_ENV__.
# Dev goes through a same-origin Vite proxy because the gateway sends no CORS headers for the dev origin:
VITE_GATEWAY_URL=
DEV_PROXY_TARGET=http://<gateway>:8088
VITE_SITE=brewery
VITE_API_KEY=replace-with-site-read-key
