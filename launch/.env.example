# Local development only. Copy to .env.local (git-ignored). In production the gateway injects window.__IGNITE_ENV__.
# `npm run dev` proxies /data/ignite to VITE_GATEWAY_URL, so the gateway's CORS list does not matter.
# The key is the site's read-only API key. Production builds never read this file.
VITE_GATEWAY_URL=http://localhost:8088
VITE_SITE=launch
VITE_API_KEY=replace-with-site-read-key
