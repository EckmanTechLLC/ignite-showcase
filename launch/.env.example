# Local development only. Copy to .env.development.local (git-ignored; never .env.local, which `vite build` would read). In production the gateway injects window.__IGNITE_ENV__.
# `npm run dev` proxies /data/ignite to VITE_GATEWAY_URL, so the gateway's CORS list does not matter.
# The key is the site's read-only API key. Production builds never read this file.
VITE_GATEWAY_URL=http://localhost:8088
VITE_SITE=launch
VITE_API_KEY=replace-with-site-read-key
# Dev only: the audit profile name that the gateway injects as IGNITE_AUDIT_PROFILE (site envVars). Omit to hide the audit ticker.
VITE_AUDIT_PROFILE=replace-with-audit-profile
